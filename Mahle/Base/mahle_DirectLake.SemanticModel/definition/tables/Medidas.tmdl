			        TRUE(),
			        ISBLANK(Porcentagem), "➖",
			        Porcentagem > 0, "🡅",
			        Porcentagem < 0, "🡇",
			        "➖"
			    )
			
			RETURN
			    Icone & " " & FORMAT(Porcentagem, "#,##0%")
		displayFolder: Texto
		lineageTag: 92f079fd-1491-4e77-85ba-6f8cf20d06d0

	measure 'Quantidade de clientes com pedidos MoM' = ```
			
			VAR UltimaData = 
			CALCULATE(
			    MAX(fVendas[datekey]),
			    REMOVEFILTERS(dCalendario)
			)
			
			VAR UltimaDataReal =
			DATE(
			    INT(UltimaData / 10000),                            -- Ano
			    INT(MOD(UltimaData, 10000) / 100),                  -- Mês
			    MOD(UltimaData, 100)                                -- Dia
			)
			
			VAR DataLimite =
			EDATE(UltimaDataReal, -1)
			
			VAR MoM =
			CALCULATE(
			    [Quantidade de clientes com pedidos],
			    DATEADD(dCalendario[Data], -1,MONTH),
			    FILTER(
			        ALL(dCalendario), dCalendario[Data] <= DataLimite
			    )
			)
			
			RETURN
			MoM
			```
		formatString: #,0
		displayFolder: Inteligencia_temporal
		lineageTag: ed1b2e18-4e5b-4818-82fa-b78c8654175c

	measure 'Ticket Medio MoM' = ```
			
			VAR UltimaData = 
			CALCULATE(
			    MAX(fVendas[datekey]),
			    REMOVEFILTERS(dCalendario)
			)
			
			VAR UltimaDataReal =
			DATE(
			    INT(UltimaData / 10000),                            -- Ano
			    INT(MOD(UltimaData, 10000) / 100),                  -- Mês
			    MOD(UltimaData, 100)                                -- Dia
			)
			
			VAR DataLimite =
			EDATE(UltimaDataReal, -1)
			
			VAR MoM =
			CALCULATE(
			    [Ticket Médio],
			    DATEADD(dCalendario[Data], -1,MONTH),
			    FILTER(
			        ALL(dCalendario), dCalendario[Data] <= DataLimite
			    )
			)
			
			RETURN
			MoM
			```
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Inteligencia_temporal
		lineageTag: 8578dd29-83b5-40e5-aabf-503632786230

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Variacao de ticket medio MoM' =
			
			VAR ValorAtual = [Ticket Médio]
			VAR ValorAnterior = [Ticket Medio MoM]
			VAR Variacao = ValorAtual - ValorAnterior
			
			RETURN
			DIVIDE(Variacao, ValorAnterior)
		formatString: 0%;-0%;0%
		displayFolder: Inteligencia_temporal
		lineageTag: 923cbb5a-dc5c-45db-b97e-e79918ad4220

