	measure 'Funil - tempo medio por sessao' =
			
			VAR tempo =
			    CALCULATE (
			        AVERAGEX (
			            VALUES ( fDatalayer_funil[session] ),
			            AVERAGE ( fDatalayer_funil[session_time_total] )
			        )
			    )
			VAR hora =
			    INT ( tempo / 3600 )
			VAR modhora =
			    MOD ( tempo, 3600 )
			VAR minutos =
			    INT ( modhora / 60 )
			VAR segundos =
			    INT ( MOD ( tempo, 60 ) )
			RETURN
			    hora * 10000 + minutos * 100 + segundos
		formatString: 00:00:00
		displayFolder: Datalayer - Funil
		lineageTag: e3f082ba-6947-4c58-a0d2-c2babfff68c1

		annotation PBI_FormatHint = {"isCustom":true}

