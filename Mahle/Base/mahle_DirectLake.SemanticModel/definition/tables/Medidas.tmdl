	/// Número de pedidos, excluindo pedidos com status:
	/// 
	/// - Cancelado
	/// - Aguardando pagamento
	/// - Pré-encomenda
	/// - Pagamento no caixa
	measure Pedidos =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[partner_order_id] )
			)
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 087a6806-8028-469a-832a-5f4d821efeb7

		changedProperty = FormatString

	/// Pedidos realizados 100% pelo cliente
	measure 'Pedidos - 100% cliente' =
			
			CALCULATE ( [Pedidos], dTipo_pedido[order_type_id] = 3 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 3968a02b-a6d1-4fc2-9ff8-1789ccbbfaf2

	/// Pedidos realizados com interação cliente-vendedor
	measure 'Pedidos - Venda assistida' =
			
			CALCULATE ( [Pedidos], dTipo_pedido[order_type_id] = 1 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 212db723-9961-4102-8398-f7f9be70845b

	/// Pedidos realizado 100% pelo vendedor.
	measure 'Pedidos - Módulo vendedor' =
			
			CALCULATE ( [Pedidos], dTipo_pedido[order_type_id] = 2 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 2bb5a88c-5917-413e-ba41-a11a52f2e530

	/// Pedidos via app
	measure 'Pedidos - App' =
			
			CALCULATE ( [Pedidos], dDispositivos[device_id] = 3 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 2e266327-b5a7-4564-b30a-a6baec9d9d6e

	/// Pedidos via desktop
	measure 'Pedidos - Desktop' =
			
			CALCULATE ( [Pedidos], dDispositivos[device_id] = 1 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 7ec221ce-eaf6-4dbb-8adb-76d9b7d45174

	/// Pedidos via mobile
	measure 'Pedidos - Mobile' =
			
			CALCULATE ( [Pedidos], dDispositivos[device_id] = 2 )
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 46c5a705-e4d6-4770-88eb-79c92455697e

	/// Valor de frete
	measure 'Valor de frete' =
			
			CALCULATE (
			    AVERAGEX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE (
			            SUM ( fVendas[median_charged_shipping] )
			        )
			    )
			)
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Pedidos\Geral
		lineageTag: 49d9f2a1-6fdb-40f8-8744-54befa04a2ca

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de pedidos transacionados pela plataforma, engloba todos os status
	/// 
	measure 'Total de pedidos' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[partner_order_id] ),
			    ALL ( dStatus_pedido[order_status_id] )
			)
		formatString: #,0
		displayFolder: Pedidos\Geral
		lineageTag: 8287ef67-1a74-4935-877b-2d0415420d1b

	measure 'Frequencia de pedidos' =
			
			VAR dtmin =
			    CALCULATE (
			        CONVERT ( MIN ( fVendas[datekey] ), DATETIME )
			    )
			VAR ciclo =
			    DATEDIFF ( dtmin, TODAY (), DAY )
			RETURN
			    DIVIDE ( ciclo, [Pedidos] )
		formatString: #,0.0
		displayFolder: Pedidos\Geral
		lineageTag: 93252523-7da7-46dd-a215-72e88b886cb0

		changedProperty = FormatString

	measure 'Frequencia de pedidos por cliente' =
			
			AVERAGEX ( VALUES ( dClientes[account_id] ), [Frequencia de pedidos] )
		formatString: #,0.0
		displayFolder: Pedidos\Geral
		lineageTag: 6f3bce38-0946-4494-aac3-a26d1bf82b85

	measure 'Frequencia de pedidos - dia útil' =
			
			VAR dtmin =
			    CALCULATE (
			        CONVERT ( MIN ( fVendas[datekey] ), DATETIME )
			    )
			VAR ciclo =
			    NETWORKDAYS ( dtmin, TODAY (), 1, VALUES ( dFeriados[Data] ) )
			RETURN
			    DIVIDE ( ciclo, [Pedidos] )
		formatString: #,0.0
		displayFolder: Pedidos\Geral
		lineageTag: b6ddc0dd-482c-4b1a-a2e9-aa64ac3811f3

	measure 'Frequencia de pedidos - dia útil por cliente' =
			
			AVERAGEX (
			    VALUES ( dClientes[account_id] ),
			    [Frequencia de pedidos - dia útil]
			)
		formatString: #,0.0
		displayFolder: Pedidos\Geral
		lineageTag: cc73f5f5-69b2-435d-b478-d95ed44437ad

	/// Quantidade distinta de itens.
	measure 'Quantidade de produtos distintos vendidos' =
			
