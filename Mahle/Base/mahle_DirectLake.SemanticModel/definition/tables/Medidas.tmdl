	measure 'Média da quantidade de itens faturados por cliente' =
			
			CALCULATE (
			    AVERAGEX ( VALUES ( fVendas[client_account_id] ), SUM ( fVendas[quantity] ) ),
			    dStatus_pedido[order_status_id] > 4
