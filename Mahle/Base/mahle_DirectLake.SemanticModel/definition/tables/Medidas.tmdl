	measure 'Frequencia de pedidos faturados - dia útil' =
			
			VAR dtmin =
			    CALCULATE (
			        CONVERT ( MIN ( fVendas[datekey] ), DATETIME ),
			        dStatus_pedido[order_status_id] > 4
			    )
			VAR ciclo =
			    NETWORKDAYS ( dtmin, TODAY (), 1, VALUES ( dFeriados[Data] ) )
			RETURN
			    DIVIDE ( ciclo, [Pedidos] )
		formatString: #,0.0
		displayFolder: Pedidos\Faturado
		lineageTag: 1fd012de-548b-4247-926e-2a735e9376cf

