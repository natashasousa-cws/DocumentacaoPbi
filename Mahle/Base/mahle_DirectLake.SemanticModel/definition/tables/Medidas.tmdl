	measure 'GMV YoY' = ```
			
			VAR UltimaData = 
			CALCULATE(
			    MAX(fVendas[datekey]),
			    REMOVEFILTERS(dCalendario)
			)
			
			VAR UltimaDataReal =
			DATE(
			    INT(UltimaData / 10000),                            -- Ano
			    INT(MOD(UltimaData, 10000) / 100),                  -- Mês
			    MOD(UltimaData, 100)                                -- Dia
			)
			
			VAR DataLimite =
			EDATE(UltimaDataReal, -12)
			
			VAR YoY =
			CALCULATE(
			    [GMV],
			    DATEADD(dCalendario[Data], -12,MONTH),
			    FILTER(
			        ALL(dCalendario), dCalendario[Data] <= DataLimite
			    )
			)
			
			RETURN
			YoY
			```
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Inteligencia_temporal
		lineageTag: b4f5b010-ff8b-4fda-96cb-2546570541ae

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'GMV MoM' = ```
			
			VAR UltimaData = 
			CALCULATE(
			    MAX(fVendas[datekey]),
			    REMOVEFILTERS(dCalendario)
			)
			
			VAR UltimaDataReal =
			DATE(
			    INT(UltimaData / 10000),                            -- Ano
			    INT(MOD(UltimaData, 10000) / 100),                  -- Mês
			    MOD(UltimaData, 100)                                -- Dia
			)
			
			VAR DataLimite =
			EDATE(UltimaDataReal, -1)
			
			VAR MoM =
			CALCULATE(
			    [GMV],
			    DATEADD(dCalendario[Data], -1,MONTH),
			    FILTER(
			        ALL(dCalendario), dCalendario[Data] <= DataLimite
			    )
			)
			
			RETURN
			MoM
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Inteligencia_temporal
		lineageTag: 7825d022-bbbb-4db1-8efc-e5232b41a6e3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

