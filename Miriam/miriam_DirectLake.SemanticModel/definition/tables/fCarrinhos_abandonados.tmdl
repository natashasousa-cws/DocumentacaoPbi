table fCarrinhos_abandonados
	lineageTag: 010d439b-b665-433e-b263-4936fcd9577f
	sourceLineageTag: [miriam].[fCarrinhos_abandonados]

	measure 'GMV Resgatado' =
			
			SUMX(
			    FILTER(
			        fCarrinhos_abandonados,
			        fCarrinhos_abandonados[cart_type] = "Carrinho abandonado"
			    ),
			    VAR curClient = fCarrinhos_abandonados[client_account_id]
			    VAR curSKU    = fCarrinhos_abandonados[sku_id]
			    VAR curDate   = fCarrinhos_abandonados[datekey]
			    VAR existeVendaPosterior =
			        CALCULATE(
			            COUNTROWS( fVendas ),
			            FILTER(
			                ALL( fVendas ),
			                fVendas[client_account_id] = curClient &&
			                fVendas[sku_id] = curSKU &&
			                fVendas[datekey] >= curDate
			            )
			        ) > 0
			    RETURN
			        IF( existeVendaPosterior,
			            fCarrinhos_abandonados[quantity] * fCarrinhos_abandonados[unit_price],
			            0
			        )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 5bddf93d-b522-41ae-b0fc-454870e97d10

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Resgatado' =
			
			DIVIDE(
			    [GMV Resgatado],
			    [Valor potencial do carrinho],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 36e45a97-5588-48ac-86ba-a06a1e5ab00b

		changedProperty = Name

		changedProperty = FormatString

	measure 'GMV Abandonado Real' =
			
			[Valor potencial do carrinho] - [GMV Resgatado]
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 5c2524ba-4f1d-4df7-a48d-66e3ba68051a

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

