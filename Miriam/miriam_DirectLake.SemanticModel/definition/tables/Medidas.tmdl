	measure 'Total de Usuários' =
			
			CALCULATE(
			    DISTINCTCOUNT( dClientes[account_id] ),
			    ALL(dCalendario),   -- <<< remove todos os filtros do calendário
			    USERELATIONSHIP(dClientes[datekey], dCalendario[datekey])
			)
		formatString: 0
		displayFolder: Usuários
		lineageTag: b181191a-297e-4808-a0f7-562cb0a23334

	measure 'Novos Usuários (últimos 12 meses)' = ```
			
			VAR DataMinDate = EDATE( TODAY(), -12 )
			VAR DataMaxDate = TODAY()
			RETURN
			CALCULATE(
			    DISTINCTCOUNT( dClientes[account_id] ),
			
			    -- Ativa relacionamento com o calendário (se precisar para outras medidas)
			    USERELATIONSHIP(dClientes[datekey], dCalendario[datekey]),
			
			    -- Filtro direto sobre a data real de criação da conta
			    FILTER(
			        ALL(dClientes),   -- <<< IMPORTANTE
			        dClientes[account_create_date] >= DataMinDate &&
			        dClientes[account_create_date] <= DataMaxDate
			    )
			)
			
			```
		formatString: 0
		displayFolder: Usuários
		lineageTag: 894475c7-e2bc-42a2-a857-84877f62d154

