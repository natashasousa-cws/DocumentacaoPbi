	measure 'Média da quantidade de itens por cliente' =
			
			CALCULATE (
			    AVERAGEX ( VALUES ( fVendas[client_account_id] ), SUM ( fVendas[quantity] ) )
			)
		formatString: #,0.0
		displayFolder: Produtos\Geral
