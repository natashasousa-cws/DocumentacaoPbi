	measure 'Receita convertida' = ```
			SUM(fMensageria_resultado_geral[order_total])
			
			```
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Mensageria
		lineageTag: 39eecd4a-b35c-49df-995f-fed4dcdf71db

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'mensageria sessoes' =
			
			CALCULATE(
			    DISTINCTCOUNT(fMensageria_resultado_navegacao[message_id]),
			    FILTER(
			        fMensageria_resultado_navegacao,
			        NOT(ISBLANK(fMensageria_resultado_navegacao[session]))
			    )
			)
		formatString: #,0
		displayFolder: Mensageria
		lineageTag: 1d516ba1-855b-4fb8-9866-b3a882955fad

	measure 'Receita convertida por campanha' =
			
			CALCULATE(
			    SUM(
			    fMensageria_resultado_geral[order_total]
			    ),
			    USERELATIONSHIP(
			        fMensageria_parametrized_send_union[id_campanha],
			        fMensageria_resultado_geral[id_campanha]
			    )
			)
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Mensageria
		lineageTag: 9e7e4fa4-2bc8-4772-8e9f-a8726aa606e8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Mensageria sessoes por campanha' =
			
			CALCULATE(
			    [mensageria sessoes],
			    USERELATIONSHIP(
			        fMensageria_parametrized_send_union[id_campanha],
			        fMensageria_resultado_navegacao[id_campanha]
			    )
			)
		formatString: #,0
		displayFolder: Mensageria
		lineageTag: 15aab4ef-5cf2-45f0-8645-4c7641b46fc7

	measure 'Pedidos convertidos por campanha' =
			
			CALCULATE(
			    [Pedidos convertidos],
			    USERELATIONSHIP(
			        fMensageria_parametrized_send_union[id_campanha],
			        fMensageria_resultado_geral[id_campanha]
			    )
			)
		formatString: 0
		displayFolder: Mensageria
		lineageTag: c7733ac9-a1b4-495f-bea4-ca84f30fbe0f

	measure '% Clientes com pedidos' = DIVIDE([Quantidade de clientes com pedidos],[Quantidade de clientes],  0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Clientes
		lineageTag: a527f407-106a-4858-af8e-4d68eb10aaa2

	measure 'Data Último Pedido por Seller' =
			
			VAR SellerID =
			    CALCULATE(
			        SELECTEDVALUE(dAssociados[copartner_id]),
			        ALLEXCEPT(dAssociados, dAssociados[trading_name])
			    )
			VAR UltimaData =
			    CALCULATE(
			        MAX(fVendas[datekey]),
			        fVendas[partner_id] = SellerID
			    )
			RETURN
			IF(
			    ISBLANK(UltimaData),
			    BLANK(),
			    DATE(
			        INT(UltimaData / 10000),
			        INT(MOD(UltimaData, 10000) / 100),
			        MOD(UltimaData, 100)
			    )
			)
		formatString: General Date
		displayFolder: Vendedores
		lineageTag: 5dc82a24-a3c4-4d1c-bcf3-9ff0cb2ff736

	measure 'Meta git teste' = 1.1
		lineageTag: f0be0bae-c27d-4521-a315-885bb2d09413

		annotation PBI_FormatHint = {"isGeneralNumber":true}

