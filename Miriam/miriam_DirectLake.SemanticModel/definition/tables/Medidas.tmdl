table Medidas
	lineageTag: 20cbf6ba-e592-4303-91c6-d31f4cd197d7

	measure GMV =
			
			CALCULATE(
			    SUMX(fVendas,
			        (fVendas[quantity] * fVendas[amount_charged]) + fVendas[median_charged_shipping] + fVendas[avg_credit_card_interest] + fVendas[avg_total_tax]
			    )
			)
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Receita digital\GMV
		lineageTag: d14aed45-e25d-4067-b213-048e8de7c248

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// GMV somando 100% cliente e venda assistida; GMV com participação do cliente
	measure 'GMV - Autoatendimento' =
			
			CALCULATE ( [GMV], dTipo_pedido[order_type_id] IN { 1, 3 } )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Receita digital\GMV
		lineageTag: 52b83aee-af26-4c5e-b53c-1a6128b2dc71

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade de logins
	measure 'Quantidade de login' =
			
			CALCULATE ( COUNT ( fLogins[login_date] ), VALUES ( fLogins[account_id] ) )
		formatString: #,0
		displayFolder: Login
		lineageTag: 69cadd85-616e-40cc-8547-8e9cd265044c

	/// Quantidade de logins para 1 pedido
	measure 'Taxa de conversão por login' =
			
			DIVIDE ( [Quantidade de login], [Total de pedidos] )
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Login
		lineageTag: b7cd3e96-f737-4130-a07f-4310bb239c46

		changedProperty = FormatString

	/// Quantidade de logins de clientes
	measure 'Quantidade de logins de cliente' =
			
			CALCULATE ( [Quantidade de login], NOT ( ISBLANK ( dClientes[client_id] ) ) )
		formatString: #,0
		displayFolder: Login
		lineageTag: c1496285-5054-430a-9707-985d3230e995

	/// Ticket Médio
	measure 'Ticket Médio' =
			
			DIVIDE ( [GMV], [Pedidos] )
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Ticket Médio\GMV
		lineageTag: 8ae24fbe-5908-4bee-a826-3c136092f76b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Ticket médio ponderado por cliente
	measure 'Ticket Médio por cliente' =
			
			AVERAGEX ( VALUES ( fVendas[client_account_id] ), [Ticket Médio] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Ticket Médio\GMV
		lineageTag: a53619d1-cbf6-42de-905d-8701902d0267

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Ticket médio ponderado por estado
	measure 'Ticket Médio por estado' =
			
			AVERAGEX ( VALUES ( dClientes[state] ), [Ticket Médio] )
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Ticket Médio\GMV
		lineageTag: 4bd4c7e7-15ef-4b60-8aa4-a04c38461c41

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Ticket médio dos pedidos em auto atendimento
	measure 'Ticket Médio - Autoatendimento' =
			
			DIVIDE ( [GMV - Autoatendimento], [Pedidos - Autoatendimento] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Ticket Médio\GMV
		lineageTag: fa8ccaae-ee8e-406d-981e-deb24e7f4821

