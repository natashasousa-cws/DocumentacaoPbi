	measure Tutorial_Balão_1 = ```
			
			"
			<div style='position: relative; max-width: 520px; margin-left: 24px; padding: 16px;
			background-color: #EAF6FC;               /* azul muito claro / fundo clean */
			border: 1px solid #1C477C;               /* azul institucional */
			border-radius: 10px;
			font-family: Segoe UI, sans-serif;
			color: rgba(0, 0, 0, 0.9);                /* grafite */
			font-size: 14px;
			box-shadow: 0px 2px 8px rgba(28, 71, 124, 0.25);'>  <!-- sombra azul -->
			
			  <!-- Seta à esquerda -->
			  <div style='position: absolute; left: -16px; top: 24px; width: 0; height: 0;
			    border-top: 14px solid transparent;
			    border-bottom: 14px solid transparent;
			    border-right: 16px solid #EAF6FC'>
			  </div>
			
			  <!-- Título -->
			  <div style='font-weight: 600; font-size: 16px; color: #0E1F33; margin-bottom: 8px;'>
			    1/7 - 🔷 Seja bem-vindo ao nosso tutorial!
			  </div>
			
			  <!-- Texto -->
			  <div style='line-height: 1.6; font-size: 15px; color: rgba(0, 0, 0, 0.75);'>
			    👈 À esquerda está o nosso <strong>menu de navegação</strong>.  
			    Você pode clicar nos ícones ou textos para <strong>mudar de página</strong>.
			  </div>
			
			  <!-- Botões -->
			  <div style='margin-top: 16px; display: flex; justify-content: flex-end; gap: 8px;'>
			
			    <span style='
			      background-color: transparent;
			      color: #1C477C;                      /* azul institucional */
			      border: 1px solid #1C477C;
			      padding: 6px 12px;
			      font-size: 14px;
			      border-radius: 16px;
			      font-weight: 500;
			      transition: 0.2s;'>
			      Finalizar
			    </span>
			
			    <span style='
			      background-color: #00ADEF;           /* azul destaque */
			      color: #FFFFFF;
			      padding: 6px 12px;
			      font-size: 14px;
			      font-weight: bold;
			      border-radius: 16px;
			      box-shadow: 0px 2px 4px rgba(0, 173, 239, 0.45);
			      transition: 0.2s;'>
			      Próximo →
			    </span>
			
			  </div>
			</div>
			"
			
			
			
			
			```
		displayFolder: Tutoriais
		lineageTag: 0edcaca9-7e13-4fbb-829c-83967d7109be

	measure Tutorial_Balão_2 = ```
			
			VAR HTMLCode =
			"
			<div style='position: relative; max-width: 520px; margin-left: 24px; padding: 16px;
			background-color: #EAF6FC;               /* azul muito claro / fundo clean */
			border: 1px solid #1C477C;               /* azul institucional */
			border-radius: 10px;
			font-family: Segoe UI, sans-serif;
			color: rgba(0, 0, 0, 0.9);                /* grafite */
			font-size: 14px;
			box-shadow: 0px 2px 8px rgba(28, 71, 124, 0.25);'>
			
			  <!-- Seta (borda) -->
			  <div style='position: absolute; right: -17px; top: 12px; width: 0; height: 0;
			    border-top: 15px solid transparent;
			    border-bottom: 15px solid transparent;
			    border-left: 17px solid #1C477C;'>
			  </div>
			
			  <!-- Seta (fundo) -->
			  <div style='position: absolute; right: -16px; top: 13px; width: 0; height: 0;
			    border-top: 14px solid transparent;
			    border-bottom: 14px solid transparent;
			    border-left: 16px solid #EAF6FC;'>
			  </div>
			
			  <!-- Título -->
			  <div style='font-weight: 600; font-size: 16px; color: #0E1F33; margin-bottom: 8px;'>
			    2/7 - 🔍 Painel de filtros
			  </div>
			
			  <!-- Texto -->
			  <div style='line-height: 1.6; font-size: 15px; color: rgba(0, 0, 0, 0.75);'>
			    👉 Clique no <strong>texto acima</strong> para acessar o painel de filtros e começar a
			    <strong>personalizar sua visualização</strong>.
			  </div>
			
			  <!-- Botões -->
			  <div style='margin-top: 16px; display: flex; justify-content: flex-end; gap: 8px;'>
			
