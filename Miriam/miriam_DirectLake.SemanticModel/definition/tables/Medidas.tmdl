	measure '% GMV do vendedor' =
			
			VAR GT = CALCULATE(
			    [GMV],
			    ALL(fVendas[client_account_id], fVendas[salesperson_account_id])
			)
			RETURN
			DIVIDE(
			    [GMV Vendedor],
			    GT
			)
		displayFolder: Receita digital\GMV
		lineageTag: 11357fdc-15e5-4d46-86b6-a66711ed8dc3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vendedor Acumulado' =
			
			CALCULATE(
			    DISTINCTCOUNT(dVendedores[account_id]),
			    dVendedores[client_id] <> BLANK(),
			    dVendedores[account_create_date] <= MAX(dCalendario[Data])
			)
		formatString: 0
		displayFolder: Vendedores
		lineageTag: 3d99c8a2-b9c5-4fed-9ef4-7f09a909d580

	measure Vendedores =
			
			CALCULATE(
			    DISTINCTCOUNT(dVendedores[account_id]),
			    dVendedores[client_id] <> BLANK(),
			    USERELATIONSHIP(dVendedores[account_create_date],dCalendario[Data])
			)
		formatString: 0
		displayFolder: Vendedores
		lineageTag: f92a1483-517e-4cba-9433-616fde618984

	measure 'Vendedores com Logins' =
			
