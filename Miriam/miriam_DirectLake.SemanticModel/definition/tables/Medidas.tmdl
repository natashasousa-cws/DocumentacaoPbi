	measure 'Média da quantidade de itens por pedido' =
			
			CALCULATE (
			    AVERAGEX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE (
			            SUM ( fVendas[quantity] ),
			            CROSSFILTER ( dProdutos[sku_id], fVendas[sku_id], BOTH )
			        )
			    )
			)
		formatString: #,0.0
		displayFolder: Produtos\Geral
