			        ISBLANK(Porcentagem), "➖",
			        Porcentagem > 0, "🡅",
			        Porcentagem < 0, "🡇",
			        "➖"
			    )
			
			RETURN
			    Icone & " " & FORMAT(Porcentagem, "#,##0%")
		displayFolder: Texto
		lineageTag: 3a416c44-84e0-439f-a16a-cc8e35d6c032

	measure 'Variacao de ticket medio MoM (c/ icone)' =
			
			VAR Porcentagem = [Variacao de ticket medio MoM]
			
			VAR Icone =
