	measure 'Rank de sku_id por pedidos' =
			
			RANKX ( ALL ( fVendas[sku_id] ), [Pedidos],, DESC )
		formatString: #,0
		displayFolder: Produtos\Geral
		lineageTag: ac2b1bcf-505e-49b5-a8ae-a86788753139

	measure 'Quantidade de categoria distintas' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dProdutos[category_level_1] ),
			    CROSSFILTER ( dProdutos[sku_id], fVendas[sku_id], BOTH ),
			    dStatus_pedido[order_status_id] > 3
			)
		formatString: #,0
		displayFolder: Produtos\Categoria
		lineageTag: 1b6536a2-2704-46e6-aa32-074b73db33c1

	measure 'Quantidade de categoria-2 distintas' =
			
