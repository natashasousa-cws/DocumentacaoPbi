	measure 'Sessao_agg - clientes distintos' =
			
			CALCULATE(
			    DISTINCTCOUNT(fDatalayer_session_summary[account_id]),
			    NOT ISBLANK(fDatalayer_session_summary[account_id])
			)
		formatString: #,0
