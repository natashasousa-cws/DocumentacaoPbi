	partition classificação_abc = m
		mode: import
		queryGroup: Calendario\Parametros
		source =
				let
				    Fonte = Odbc.Query("dsn=Athena", "with vd_produto as (#(lf)select#(lf)#(tab)v.""id do produto"" sku_id, #(lf)#(tab)SUM( cast( replace( replace(""preço cobrado item"" , '.', ''), ',', '.') AS decimal(11, 2)) * ""quantidade de itens"") vd_produto#(lf)from bi.venda v#(lf)where #(lf)#(tab)v.""id site"" in (8638) and#(lf)#(tab)v.""status do pedido"" not in ('Cancelado', 'Aguardando pagamento', 'Pré-encomenda')#(lf)GROUP BY #(lf)#(tab)v.""id do produto""#(lf)#(tab))#(lf)select #(lf)#(tab)vdp.sku_id,#(lf)#(tab)vdp.vd_produto,#(lf)#(tab)sum(vdp.vd_produto) over (order by vdp.vd_produto desc) venda_acc,#(lf)#(tab)sum(vdp.vd_produto) over () venda_total,#(lf)#(tab)sum(vdp.vd_produto) over (order by vdp.vd_produto desc) / sum(vdp.vd_produto) over () pct_acc,#(lf)#(tab)case #(lf)#(tab)#(tab)when sum(vdp.vd_produto) over (order by vdp.vd_produto desc) / sum(vdp.vd_produto) over () <= 0.80 then 'A'#(lf)#(tab)#(tab)when sum(vdp.vd_produto) over (order by vdp.vd_produto desc) / sum(vdp.vd_produto) over () <= 0.95 then 'B'#(lf)#(tab)#(tab)else 'C'#(lf)#(tab)end class_abc#(lf)from vd_produto vdp")
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

