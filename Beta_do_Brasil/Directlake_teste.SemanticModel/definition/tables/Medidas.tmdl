table Medidas
	lineageTag: 20cbf6ba-e592-4303-91c6-d31f4cd197d7

	/// Coluna oculta padrão para tabelas de medidas
	column _
		isHidden
		formatString: 0
		lineageTag: 3ecc4be6-5ff5-4179-ae22-435e9aba9748
		summarizeBy: none
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	/// Definição da partição calculada
	partition Medidas = calculated
		mode: import
		source = ROW ( "Column", BLANK () )

	measure GMV =
			CALCULATE(
				SUMX(fVendas,
					(fVendas[quantity] * fVendas[amount_charged]) + fVendas[median_charged_shipping] + fVendas[avg_credit_card_interest] + fVendas[avg_total_tax]
				)
			)
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Receita digital\GMV
		lineageTag: d14aed45-e25d-4067-b213-048e8de7c248
		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	annotation PBI_Id = 5e114c18271b4f2582bd09238c5643c8
