table dCustomer_type
	lineageTag: 3c293364-27b0-40ef-9b46-a596513cf261

	measure 'clients customer_type' = DISTINCTCOUNT(dCustomer_type[customer_id])
		formatString: #,0
		lineageTag: a52af05a-3c9b-47ec-8d44-ce6b1ec520d7

	measure 'bloqueio v1' =
			
			CALCULATE(
			    [clients customer_type],
			    NOT(dCustomer_type[bloqueio] = BLANK())
			)
		formatString: #,0
		lineageTag: 73dec931-40de-404c-b815-52ca6e2ba019

	measure amigo_leo =
			
			CALCULATE(
			    [clients customer_type],
			    NOT(dCustomer_type[categoria_amigoleo] = BLANK())
			)
		formatString: #,0
		lineageTag: 7e91c204-7231-44cb-9532-db4192a573e2

	measure 'classe v1' =
			
			CALCULATE(
			    [clients customer_type],
			    NOT(dCustomer_type[classe] = BLANK())
			)
		formatString: #,0
		lineageTag: 1cf02ef9-2347-4c9a-95bc-6cd58ed5a889

	measure dias_nca =
			
			CALCULATE(
			    [clients customer_type],
			    NOT(dCustomer_type[dias_ncaprazo] = BLANK())
			)
		formatString: #,0
		lineageTag: 1ad87d78-abfe-4282-95e5-67580bf75e94

	measure 'ramo v1' =
			
			CALCULATE(
			    [clients customer_type],
			    NOT(ISBLANK(dCustomer_type[ramo]))
			)
		formatString: #,0
		lineageTag: ee3cfe90-0706-4df6-8b79-0ef3a2cc80fc

	measure 'Resultado por Tipo de Cliente' =
			
			SWITCH(
			    SELECTEDVALUE(aux_customer_type[Categoria]),
			    "Bloqueio", [bloqueio v1],
			    "Categoria_amigoleo", [amigo_leo],
			    "Classe", [classe v1],
			    "Dias_ncaprazo", [dias_nca],
			    "ramo", [ramo v1],
			    2
			)
		formatString: #,0
		lineageTag: ec8007c7-fb9c-4107-8b0c-e818c9fb20df

	measure '% clients customer_type' =
			
			DIVIDE(
			    [Resultado por Tipo de Cliente],
			    [clients customer_type]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0f88956b-57c1-4519-acb7-5954b2d42d74

	measure 'bloqueio v1 off' =
			
			CALCULATE(
			    [clients customer_type],
			    dCustomer_type[bloqueio] = BLANK()
			)
		formatString: #,0
		lineageTag: f8adae57-b5fc-43aa-8d34-a274d4bf2e9d

	measure 'amigo_leo off' =
			
			CALCULATE(
			    [clients customer_type],
			    dCustomer_type[categoria_amigoleo] = BLANK()
			)
		formatString: #,0
		lineageTag: 592c6779-65dd-4210-b1cc-a0d173edcda2

	measure 'classe v1 off' =
			
			CALCULATE(
			    [clients customer_type],
			    dCustomer_type[classe] = BLANK()
			)
		formatString: #,0
		lineageTag: d3d81985-dc2c-42a0-9fbb-a1c906671b5f

	measure 'dias_nca off' =
			
			CALCULATE(
			    [clients customer_type],
			    dCustomer_type[dias_ncaprazo] = BLANK()
			)
		formatString: #,0
		lineageTag: 2422958c-f2b8-42c2-a538-a3d3f7533d45

	measure 'ramo v1 off' =
			
			CALCULATE(
			    [clients customer_type],
			    ISBLANK(dCustomer_type[ramo])
			)
		formatString: #,0
		lineageTag: bea52e0d-91d3-4052-b3c0-f054e6b8a776

