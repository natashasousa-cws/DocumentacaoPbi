table fDatalayer_sku_conversion
	lineageTag: 039142b9-29c5-4b97-841a-0c6d488d1ac1

	measure Conversion_rate =
			
			DIVIDE(
			    SUM(fDatalayer_sku_conversion[times_bought]),
			    SUM(fDatalayer_sku_conversion[viewed_sessions])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 50326961-b713-42b7-bbab-941ee0809264

	measure Times_bought_ =
			
			SUM(fDatalayer_sku_conversion[times_bought])
		formatString: 0
		lineageTag: b849674c-cdae-42a6-ac97-fb7c7542d9bc

	measure Times_viewed =
			
			SUM(fDatalayer_sku_conversion[viewed_sessions])
		formatString: 0
		lineageTag: 382a4748-8c49-4f26-98fb-e423caabaa76

	measure '% conversion catalogue' =
			
			DIVIDE(
			    DISTINCTCOUNT(fDatalayer_sku_conversion[sku_id]),
			    [catalogue_count])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fc9c71f3-5bcd-4b8e-a7c2-3e54295193c9

