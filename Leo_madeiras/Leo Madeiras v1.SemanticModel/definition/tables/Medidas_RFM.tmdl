		displayFolder: 105. GMV/Classificação
		lineageTag: 0b2420fb-7de6-4228-8987-8ee1fb0379ce

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '105.11 $RFM_Lost' =
			
			CALCULATE (
			    [101.03 M - GMV Last X Months],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] <= 2
			            && [102.04 RFM_(F+M)/2] <= 2
			    )
			) - [105.05 $RFM_Hibernating]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 105. GMV/Classificação
		lineageTag: 4fa4d84c-ae2a-41a0-b198-32b233b05ff8

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '105.12 RFM_Classificação' =
			
			VAR segRFM =
			    SELECTEDVALUE ( 'aux_RFM_Classificação'[Segmentação] )
			RETURN
			    SWITCH (
			        TRUE (),
			        segRFM = "Campeões", [105.01 $RFM_Champion],
			        segRFM = "Clientes fiéis", [105.02 $RFM_Loyal],
			        segRFM = "Potenciais fiéis", [105.03 $RFM_Potential],
			        segRFM = "Clientes recentes", [105.04 $RFM_New_Client],
			        segRFM = "Hibernando", [105.05 $RFM_Hibernating],
			        segRFM = "Promissores", [105.06 $RFM_Promising],
			        segRFM = "Precisam de atenção", [105.07 $RFM_Attention],
			        segRFM = "Prestes a hibernar", [105.08 $RFM_Sleep],
			        segRFM = "Não posso perder", [105.09 $RFM_Cant_Lose],
			        segRFM = "Em risco", [105.10 $RFM_At_Risk],
			        segRFM = "Perdidos", [105.11 $RFM_Lost],
			        BLANK ()
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 105. GMV/Classificação
		lineageTag: 45b898a2-e9dc-449a-bdb3-0c221bcaa629

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition Medidas_RFM-33586637-1f43-4617-b566-566fd08764a7 = m
		mode: import
		queryGroup: 'Analise RFM'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
