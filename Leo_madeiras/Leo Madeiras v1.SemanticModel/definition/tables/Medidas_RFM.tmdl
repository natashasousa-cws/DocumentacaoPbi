	measure 'Segmentacao selecionada' =
			
			"Clique aqui para detalhar "
			    & SELECTEDVALUE ( 'aux_RFM_Classificação'[Segmentação] )
		displayFolder: 101. Base
		lineageTag: 57ba0c14-4098-43b7-9de4-986cfb09e671

	measure '103.12 RFM_Classificação' =
			
			VAR SegRFM =
			    SELECTEDVALUE ( 'aux_RFM_Classificação'[Segmentação] )
			RETURN
			    SWITCH (
			        TRUE (),
			        SegRFM = "Campeões", [103.01 RFM_Champion],
			        SegRFM = "Clientes fiéis", [103.02 RFM_Loyal],
			        SegRFM = "Potenciais fiéis", [103.03 RFM_Potential],
			        SegRFM = "Clientes recentes", [103.04 RFM_New_Client],
			        SegRFM = "Hibernando", [103.05 RFM_Hibernating],
			        SegRFM = "Promissores", [103.06 RFM_Promissing],
			        SegRFM = "Precisam de atenção", [103.07 RFM_Attention],
			        SegRFM = "Prestes a hibernar", [103.08 RFM_Sleep],
			        SegRFM = "Não posso perder", [103.09 RFM_Cant_Lose],
			        SegRFM = "Em risco", [103.10 RFM_At_Risk],
			        SegRFM = "Perdidos", [103.11 RFM_Lost],
			        BLANK ()
			    )
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: e67fc091-1fec-48d8-8f50-064a39e363e1

		changedProperty = FormatString

