	measure '103.10 RFM_At_Risk' =
			
			VAR AtRisk =
			    CALCULATE (
			        [02.00 Clients],
			        FILTER (
			            VALUES ( dClientes[account_id] ),
			            [102.01 RFM_RX] > 0
			                && [102.01 RFM_RX] <= 2
			                && [102.04 RFM_(F+M)/2] > 2
			                && [102.04 RFM_(F+M)/2] <= 5
			        )
			    )
			VAR Resultado = AtRisk - [103.09 RFM_Cant_Lose]
			RETURN
			    Resultado
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: f54a1248-5d24-43f4-ab1f-9cea1effae22

		changedProperty = FormatString

	measure '102.01 RFM_RX' =
			
			CALCULATE (
			    SELECTEDVALUE ( aux_RFM_Recency[id] ),
			    FILTER (
			        aux_RFM_Recency,
			        DATEDIFF ( [101.01 R - Lastest_sale], MAX ( dCalendario[Data] ), DAY ) > aux_RFM_Recency[Min]
			            && DATEDIFF ( [101.01 R - Lastest_sale], MAX ( dCalendario[Data] ), DAY ) <= aux_RFM_Recency[Max]
			    )
			)
		formatString: 0
		displayFolder: 102. Rank
