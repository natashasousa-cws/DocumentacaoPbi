			            && [102.04 RFM_(F+M)/2] > 1
			            && [102.04 RFM_(F+M)/2] <= 3
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: 439af519-3b4d-42d3-ad9c-f671c8a8095c

