table Medidas_RFM
	lineageTag: 3466e735-dd55-4358-8356-b07dfa2deec3

	measure '101.03 M - GMV Last X Months' =
			
			CALCULATE (
			    [01.00 GMV],
			    DATESINPERIOD (
			        dCalendario[Data],
			        MAX ( dCalendario[Data] ),
			        - [param_RFV_period Valor],
			        MONTH
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 101. Base
		lineageTag: 8f7f4a0c-04a6-41f8-a0f6-d18c77a2bb09

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '101.01 R - Lastest_sale' =
			
			CALCULATE (
			    MAX ( fVendas[order_date] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } ),
			    dCalendario[Data] <= MAX ( dCalendario[Data] )
			)
		formatString: dd/mm/yyyy
		displayFolder: 101. Base
		lineageTag: f71b4660-4aa9-4796-a03c-9a1243afbfeb

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure '101.02 F - Orders Last X Months' =
			
			CALCULATE (
			    [05.00 Orders],
			    DATESINPERIOD (
			        dCalendario[Data],
			        MAX ( dCalendario[Data] ),
			        - [param_RFV_period Valor],
			        MONTH
			    )
			)
		formatString: 0
		displayFolder: 101. Base
		lineageTag: 24ac5d91-d923-4d58-9c8d-16ff732d1836

	measure '104.01 %RFM_Champion' =
			
			DIVIDE ( [103.01 RFM_Champion], [02.00 Clients] )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: 104. GT
		lineageTag: d364c371-738a-4a89-a07e-7e57b98fc774

		changedProperty = FormatString

	measure '102.00 RFM Clients' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        dClientes,
			        DATEDIFF ( [101.01 R - Lastest_sale], MAX ( dCalendario[Data] ), DAY )
			            > MIN ( aux_RFM_Recency[Min] )
			            && DATEDIFF ( [101.01 R - Lastest_sale], MAX ( dCalendario[Data] ), DAY )
			                <= MAX ( aux_RFM_Recency[Max] )
			            && [101.02 F - Orders Last X Months] >= MIN ( aux_RFM_Frequency[Min] )
			            && [101.02 F - Orders Last X Months] < MAX ( aux_RFM_Frequency[Max] )
			            && [101.03 M - GMV Last X Months] >= MIN ( aux_RFM_Monetary[Min] )
			            && [101.03 M - GMV Last X Months] < MAX ( aux_RFM_Monetary[Max] )
			    )
			)
		formatString: 0
		displayFolder: 102. Rank
		lineageTag: 5a2e7271-df40-4dc7-8e2a-bfd410008359

	measure '103.09 RFM_Cant_Lose' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] > 0
			            && [102.01 RFM_RX] <= 1
			            && [102.04 RFM_(F+M)/2] > 4
			            && [102.04 RFM_(F+M)/2] <= 5
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: c6bd6058-df43-48dc-b498-222174fab921

		changedProperty = FormatString

	measure '102.04 RFM_(F+M)/2' =
			
			( [102.02 RFM_FX] + [102.03 RFM_MX] ) / 2
		displayFolder: 102. Rank
		lineageTag: bee3a305-c5fd-497f-9123-fd583dc61d46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '103.07 RFM_Attention' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] > 2
			            && [102.01 RFM_RX] <= 3
			            && [102.04 RFM_(F+M)/2] > 2
			            && [102.04 RFM_(F+M)/2] <= 3
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: 7bbf69c9-cd8d-4d2e-b108-2f290e8a1287

		changedProperty = FormatString

	measure '103.01 RFM_Champion' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] > 4
			            && [102.01 RFM_RX] <= 999
			            && [102.04 RFM_(F+M)/2] > 4
			            && [102.04 RFM_(F+M)/2] <= 5
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: 986077a9-5723-41d2-81b5-42a889f2eeef

		changedProperty = FormatString

	measure '102.02 RFM_FX' =
			
			CALCULATE (
			    SELECTEDVALUE ( aux_RFM_Frequency[ID] ),
			    FILTER (
			        aux_RFM_Frequency,
			        [101.02 F - Orders Last X Months] >= aux_RFM_Frequency[Min]
			            && [101.02 F - Orders Last X Months] < aux_RFM_Frequency[Max]
			    )
			)
		formatString: 0
		displayFolder: 102. Rank
		lineageTag: dd43bf4c-c03a-4060-899b-1a72ea695ea4

	measure '103.05 RFM_Hibernating' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] = 2
			            && [102.04 RFM_(F+M)/2] = 2
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: d7d3bd03-d9bd-4e07-98fa-ede3eed2db66

		changedProperty = FormatString

	measure '103.11 RFM_Lost' =
			
			VAR Lost =
			    CALCULATE (
			        [02.00 Clients],
			        FILTER (
			            VALUES ( dClientes[account_id] ),
			            [102.01 RFM_RX] <= 2
			                && [102.04 RFM_(F+M)/2] <= 2
			        )
			    )
			VAR Resultado = Lost - [103.05 RFM_Hibernating]
			RETURN
			    Resultado
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: 4ae2dbaa-7de4-438f-ba6a-08f0407f9553

		changedProperty = FormatString

	measure '103.02 RFM_Loyal' =
			
			VAR Loyal =
			    CALCULATE (
			        [02.00 Clients],
			        FILTER (
			            VALUES ( dClientes[account_id] ),
			            [102.01 RFM_RX] > 2
			                && [102.01 RFM_RX] <= 999
			                && [102.04 RFM_(F+M)/2] > 3
			                && [102.04 RFM_(F+M)/2] <= 5
			        )
			    )
			VAR Resultado = Loyal - [103.01 RFM_Champion]
			RETURN
			    Resultado
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: 8ac6b433-f13f-4628-b4d3-095a94c8bf80

		changedProperty = FormatString

	measure '103.04 RFM_New_Client' =
			
			CALCULATE (
			    [02.00 Clients],
			    FILTER (
			        VALUES ( dClientes[account_id] ),
			        [102.01 RFM_RX] > 4
			            && [102.01 RFM_RX] <= 999
			            && [102.04 RFM_(F+M)/2] > 0
			            && [102.04 RFM_(F+M)/2] <= 1
			    )
			)
		formatString: #,0
		displayFolder: 103. Classificação
		lineageTag: e1000c72-971f-41aa-b116-06bd52ccdb6d

		changedProperty = FormatString

