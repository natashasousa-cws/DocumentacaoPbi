table param_ActiveClients
	isHidden
	lineageTag: 4373f107-af71-47d3-83f5-346af74352d4

	measure 'param_ActiveClients Valor' =
			
			SELECTEDVALUE ( 'param_ActiveClients'[param_ActiveClients], 1 )
		formatString: 0
		isHidden
		lineageTag: 5af9973d-cbd2-416a-8c10-c3e9b1365cbd

	/// Texto dinâmico para clientes ativos
	measure 'Titulo active clients' =
			
			VAR Seletor = [param_ActiveClients Valor]
			VAR dtFinal =
			    MAX ( dCalendario[Data] )
			VAR dtInicio =
			    EDATE ( dtFinal, - Seletor )
			RETURN
			    "Clientes ativos no periodo de " & Seletor & " mês(es), periodo entre " & dtInicio & " à " & dtFinal & "."
		isHidden
		lineageTag: 8104e37d-36e7-4e0d-a257-d067cd2e6a4c

