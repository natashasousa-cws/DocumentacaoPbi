table fDatalayer_navegation_exploded
	lineageTag: b75aa290-d676-4b8c-a5e4-ebb88c110640

	measure Qtd_sessions_funil =
			
			CALCULATE(
			    DISTINCTCOUNT(
			        fDatalayer_navegation_exploded[session]
			    )
			)
		formatString: #,0
		lineageTag: 11d1c85c-609d-43a4-8778-982059fdd5b3

	measure 'Med Cor' =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(fDatalayer_navegation_exploded[1]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[2]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[3]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[4]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[5]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[6]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[7]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[8]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[9]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[10]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[11]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[12]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[13]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[14]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[15]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[16]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[17]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[18]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[19]) = "End", "Red",
			    SELECTEDVALUE(fDatalayer_navegation_exploded[20]) = "End", "Red",
			    "Green")
		lineageTag: 9d92abff-c8f4-4995-bd1c-a6c43f27b1bb

	measure 'Paginas distintas' =
			
			CALCULATE(
			    DISTINCTCOUNT(
			        fDatalayer_navegation_exploded[1]
			    )
			)
		formatString: #,0
		lineageTag: c866e764-53de-4a2f-a9f3-980d533e9062

	measure 'Paginas visitadas' =
			
			CALCULATE(
			    COUNT(
			        fDatalayer_navegation_exploded[1]
			    )
			)
		formatString: #,0
		lineageTag: 1535512e-e5dd-43cd-9226-76aa2a757645

	measure 'Eventos por sessão' =
			
			DIVIDE(
			    [Paginas visitadas],
			    [Qtd_sessions_funil],
			    BLANK()
			)
		formatString: 0.0
		lineageTag: d09bfa57-b143-46d2-86e4-52e0a78f97bf

