	/// Total de vendedores.
	/// 
	/// Vendedor é definido como conta com client_id.
	/// 
	/// As informações de vendedores se encontram em dVendedores
	measure '07.00 Salesperson' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dVendedores[account_id] ),
			    dVendedores[client_id] <> BLANK (),
			    USERELATIONSHIP ( dVendedores[client_create_date], dCalendario[Data] )
			)
