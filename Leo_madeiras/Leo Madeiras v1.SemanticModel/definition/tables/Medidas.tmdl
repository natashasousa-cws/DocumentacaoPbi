	measure 'Dias com compra' =
			
			VAR dtAtual =
			    MAX ( dCalendario[Data] )
			VAR Datas =
			    ALL ( dCalendario[Data] )
			VAR DataComVenda =
			    CALCULATETABLE (
			        VALUES ( fVendas[order_date] ),
			        fVendas[order_status] IN { "Pronto", "Enviado", "Completo" },
			        ALLSELECTED ()
			    )
			VAR DataSemVendas =
			    EXCEPT ( Datas, DataComVenda )
			VAR UltimodiaSemvenda =
			    MAXX (
			        FILTER ( DataSemVendas, dCalendario[Data] <= dtAtual ),
			        dCalendario[Data]
			    )
			VAR Resultado =
			    INT ( dtAtual - UltimodiaSemvenda )
			RETURN
			    Resultado
		formatString: 0
		displayFolder: 95. Temporais
		lineageTag: 7cfd674d-5eb1-4b0d-96e3-49c512fb422c

	measure 'Dias sem compra' =
			
			VAR dtAtual =
			    MAX ( dCalendario[Data] )
			VAR mindt =
			    CALCULATE ( MIN ( dCalendario[Data] ), REMOVEFILTERS () )
			VAR mindt2 =
			    MIN ( dClientes[account_create_date] )
			VAR UltimaCompra =
			    CALCULATE (
			        MAX ( fVendas[order_date] ),
			        fVendas[order_status] IN { "Pronto", "Enviado", "Completo" },
			        dCalendario[Data] <= dtAtual
			    )
			VAR dtanterior =
			    COALESCE ( UltimaCompra, mindt2 )
			VAR Resultado =
			    DATEDIFF ( dtAtual, dtanterior, DAY ) * -1
			RETURN
			    IF (
			        HASONEVALUE ( dClientes[account_id] ),
			        SWITCH (
			            TRUE (),
			            Resultado = 0
			                && [01.00 GMV] > 0, "Comprou",
			            Resultado > 0, Resultado,
			            Resultado < 0, "Cliente não criado",
			            "Cliente criado"
			        ),
			        "Selecione um cliente"
			    )
		displayFolder: 95. Temporais
		lineageTag: 15c94c14-e44e-4ceb-a4b6-6fd6c9393b01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

