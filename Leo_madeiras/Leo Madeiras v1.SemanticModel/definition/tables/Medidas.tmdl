	measure Barra =
			
			VAR Maior_valor =
			    MAXX ( ALLSELECTED ( dVendedores[name] ), [01.00 GMV] )
			VAR Repeticao =
			    DIVIDE ( [01.00 GMV], Maior_valor ) * 10
			VAR RotDados =
			    SWITCH (
			        TRUE (),
			        [01.00 GMV] >= 1000000000, FORMAT ( [01.00 GMV], "R$ #,0,,,.0 Bi" ),
			        [01.00 GMV] >= 1000000, FORMAT ( [01.00 GMV], "R$ #,0,,.0 Mi" ),
			        [01.00 GMV] >= 1000, FORMAT ( [01.00 GMV], "R$ #,0,.0 mil" )
			    )
			VAR Variacao =
			    FORMAT ( [Variacao GMV], "↗️0.0%;↘️-0.0%;0.0%" )
			RETURN
			    REPT ( "▇", Repeticao ) & " " & RotDados & " " & Variacao
		lineageTag: f39be769-8c08-4db3-8863-ed67e86cbb0a

	measure 'Variacao GMV' =
			
			VAR GMV = [01.00 GMV]
			VAR GMV_O =
			    CALCULATE ( [01.00 GMV], ALL ( dPeriodos ), dPeriodos[Ordem] = 2 )
			VAR GMV_SP =
			    CALCULATE ( [01.00 GMV], ALL ( dPeriodos ), dPeriodos[Ordem] = 5 )
			VAR GMV_MP =
			    CALCULATE ( [01.00 GMV], ALL ( dPeriodos ), dPeriodos[Ordem] = 9 )
			VAR GMV_AP =
			    CALCULATE ( [01.00 GMV], ALL ( dPeriodos ), dPeriodos[Ordem] = 11 )
			VAR GMV_YTDLY =
			    CALCULATE ( [01.00 GMV], ALL ( dPeriodos ), dPeriodos[Ordem] = 15 )
			VAR variacao_O =
			    DIVIDE ( GMV - GMV_O, GMV_O )
			VAR variacao_SP =
			    DIVIDE ( GMV - GMV_SP, GMV_SP )
			VAR variacao_MP =
			    DIVIDE ( GMV - GMV_MP, GMV_MP )
			VAR variacao_AP =
			    DIVIDE ( GMV - GMV_AP, GMV_AP )
			VAR variacao_YTDLY =
			    DIVIDE ( GMV - GMV_YTDLY, GMV_YTDLY )
			RETURN
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( dPeriodos[Ordem] ) = 1, variacao_O,
			        SELECTEDVALUE ( dPeriodos[Ordem] ) = 3, variacao_SP,
			        SELECTEDVALUE ( dPeriodos[Ordem] ) = 7, variacao_MP,
			        SELECTEDVALUE ( dPeriodos[Ordem] ) = 10, variacao_AP,
			        SELECTEDVALUE ( dPeriodos[Ordem] ) = 14, variacao_YTDLY
			    )
		lineageTag: 9fc329f3-0707-4f3f-83e2-d51e17b5b351

		annotation PBI_FormatHint = {"isGeneralNumber":true}

