		lineageTag: 4d548ccb-a378-4eed-a7c3-92b60e307656

	measure '03.01 % Logins client' =
			
			VAR Client_login_count =
			    CALCULATE (
			        DISTINCTCOUNT ( fLogins[account_id] ),
			        dClientes[account_id] <> BLANK ()
			    )
			RETURN
			    DIVIDE ( Client_login_count, [02.00 Clients] )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: 20. GT%
		lineageTag: 546b9b63-dd51-46a6-b467-873e6241d78b

