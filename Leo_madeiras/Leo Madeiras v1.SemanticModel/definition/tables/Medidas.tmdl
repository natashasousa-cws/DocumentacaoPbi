	/// Soma dos totais de pedidos, excluindo pedidos com status:
	/// 
	/// - Cancelado
	/// - Aguardando pagamento
	/// - Pré-encomenda
	/// 
	/// É utilizado pelo financeiro para a criação de reports.
	measure '01.07 GMV Finance' =
			
			CALCULATE (
			    SUMX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE (
			            AVERAGE ( fVendas[order_total] ),
			            NOT ( fVendas[order_status]
			                IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda" } )
			        )
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 14ee0981-cac9-4010-ac05-b0de51571f5d

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de GMV transacionado pela plataforma, engloba todos os status.
	measure '01.09 GMV Potential' =
			
			CALCULATE (
			    SUMX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE ( AVERAGE ( fVendas[order_total] ), ALL ( fVendas[order_status] ) )
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 120e5f34-9b4c-4405-9eda-00c816e7fc3c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade acumulada de clientes até a data máxima selecionada.
	measure '02.31 Clients Accum' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dClientes[account_id] ),
			    NOT ( ISBLANK ( dClientes[client_id] ) ),
			    dClientes[account_create_date] <= MAX ( dCalendario[Data] )
			)
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 6ec0397e-3f8b-4a4c-82e5-287f412ff5c5

		changedProperty = FormatString

	/// Valor do GMV que teve algum tipo desconto aplicado.
	measure '01.08 GMV Coupons' =
			
			CALCULATE ( [01.00 GMV], fVendas[coupon_id] <> BLANK () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 3f448624-f2be-46bd-8787-049e690c3aa7

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Número de pedidos, excluindo pedidos com status:
	/// 
	/// - Cancelado
	/// - Aguardando pagamento
	/// - Pré-encomenda
	/// - Pagamento no caixa
	measure '05.00 Orders' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[partner_order_id] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } )
			)
		formatString: #,0
		displayFolder: 05. Orders
		lineageTag: 0a6a4aac-8871-454a-9a5a-5561df4ba9a1

		changedProperty = FormatString

	/// Pedidos realizados 100% pelo cliente
	measure '05.01 Orders AA' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_type] IN { "100% cliente" } )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 0159c74f-fd0c-443e-9194-b643e6fb185e

	/// Pedidos realizados com interação cliente-vendedor
	measure '05.02 Orders VA' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_type] IN { "Venda assistida" } )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 4418b725-df23-4852-99dc-94e710078402

	/// Pedidos realizado 100% pelo vendedor.
	measure '05.03 Orders MV' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_type] IN { "100% vendedor" } )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 55746355-4f2e-440b-bbbf-a4e71528aa8b

	/// Pedidos via app
	measure '05.04 Orders App' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_device] = "App" )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 7b963d14-4dac-4629-8c14-026f295c2ead

	/// Pedidos via desktop
	measure '05.05 Orders Desktop' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_device] = "Desktop" )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: c8f4563d-8b47-4514-bfc0-2906b508b808

	/// Pedidos via mobile
	measure '05.06 Orders Mobile' =
			
			CALCULATE ( [05.00 Orders], fVendas[order_device] = "Mobile" )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 23f3f7f3-2b34-494e-8cf5-1e334ddc2f3b

	/// Pedidos com cupom
	measure '05.16 Orders Coupons' =
			
			CALCULATE ( [05.00 Orders], fVendas[coupon_id] <> BLANK () )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 47270c74-3c33-4289-b77a-042ab75f554d

	/// Quantidade de clientes entre os periodos selecionados.
	measure '02.32 Clients per date' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dClientes[account_id] ),
			    NOT ( ISBLANK ( dClientes[client_id] ) ),
			    dClientes[account_create_date] <= MAX ( dCalendario[Data] ),
			    USERELATIONSHIP ( dCalendario[Data], dClientes[account_create_date] )
			)
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: dc636f83-0d98-4d36-a96e-b0ccd3296568

		changedProperty = FormatString

	/// Total de clientes.
	/// 
	/// Clientes é definido como conta com client_id.
	/// 
	/// Podem existir mais contas que clientes.
	/// 
	/// As informações de clientes se encontram em dClientes
	measure '02.00 Clients' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dClientes[account_id] ),
			    NOT ( ISBLANK ( dClientes[client_id] ) ),
			    USERELATIONSHIP ( dClientes[client_create_date], dCalendario[Data] )
			)
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: a03279e8-ea83-472a-96fd-7c915e4d4176

		changedProperty = FormatString

	/// Clientes com compras em autoatendimento.
	measure '02.01 Clients AA' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.01 Orders AA] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 24b2b1bd-4a50-49ea-80ac-bcae786d2ae9

		changedProperty = FormatString

	/// Clientes com compras assistida.
	measure '02.02 Clients VA' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.02 Orders VA] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: a3a30c0f-16ac-4313-be64-ffee64c0dd36

		changedProperty = FormatString

	/// Clientes com compras em módulo vendedor
	measure '02.03 Clients MV' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.03 Orders MV] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 4dca2642-d158-4420-9de3-21bda81130ac

		changedProperty = FormatString

	/// Clientes com compras via APP
	measure '02.04 Clients App' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.04 Orders App] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: cdeb3568-6c0b-48e4-abd8-191bc28a21ad

		changedProperty = FormatString

	/// Clientes com compras via Desktop
	measure '02.05 Clients Desktop' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.05 Orders Desktop] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 8d1709b8-5968-4fdb-83f2-d30a382023ed

		changedProperty = FormatString

	/// Clientes com compras via celular
	measure '02.06 Clients Mobile' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.06 Orders Mobile] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: c10c7aca-3c13-4824-a991-743bf5c3e96d

		changedProperty = FormatString

	/// Clientes com algum pedido
	measure '02.33 Clients w orders' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [05.00 Orders] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 21154579-dbe4-4941-b684-c6ef3cb11645

		changedProperty = FormatString

	/// Quantidade distinta de itens.
	measure '06.99 Distinct SKU' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[sku_id] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda" } )
			)
		formatString: #,0
		displayFolder: 06. Products
		lineageTag: 6ff5219e-16eb-459e-af4d-b0339191b63a

		changedProperty = FormatString

	/// Ticket Médio
	measure '04.00 ATP' =
			
			DIVIDE ( [01.00 GMV], [05.00 Orders] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 04. Average Ticket Price
		lineageTag: 124b07b2-9c4c-40cb-9f5e-d3c470b0f7fd

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade de clientes ativos no periodo selecionado. 
	/// 
	/// É necessário utilizar junto das medidas [XX.30]
	/// 
	/// O parametro que controla essa medida, por padrão, é [Data máxima] - 1 Mês
	/// 
	/// Usar a coluna param_ActiveClients para modificar
	measure '02.30 Active Clients' =
			
			VAR Seletor = [param_ActiveClients Valor]
			VAR dtFinal =
			    MAX ( dCalendario[Data] )
			VAR dtInicio =
			    EDATE ( dtFinal, - Seletor )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fVendas[client_account_id] ),
			        NOT ( fVendas[order_status]
			            IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda" } ),
			        USERELATIONSHIP ( dClientes[account_create_date], dCalendario[Data] ),
			        DATESBETWEEN ( dCalendario[Data], dtInicio, dtFinal )
			    )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: b50ff75f-09b7-48cc-91ef-0bdcde4d291a

		changedProperty = FormatString

	/// GMV dos clientes ativos no periodo selecionado.
	/// É necessário utilizar junto da medida [02.30]
	/// 
	/// O parametro que controla essa medida, por padrão, é [Data máxima] - 1 Mês
	/// 
	/// Usar a coluna param_ActiveClients para modificar
	measure '01.30 GMV - Active Clients' =
			
			/// Usar em conjunto com a medida 02.15 ///
			VAR Seletor = [param_ActiveClients Valor]
			VAR dtFinal =
			    MAX ( dCalendario[Data] )
			VAR dtInicio =
			    EDATE ( dtFinal, - Seletor )
			RETURN
			    CALCULATE (
			        [01.00 GMV],
			        NOT ( fVendas[order_status]
			            IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } ),
			        DATESBETWEEN ( dCalendario[Data], dtInicio, dtFinal )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 17f4de30-6500-4eda-a018-606950836ee1

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Pedidos dos clientes ativos no periodo selecionado.
	/// É necessário utilizar junto da medida [02.30]
	/// 
	/// O parametro que controla essa medida, por padrão, é [Data máxima] - 1 Mês
	/// 
	/// Usar a coluna param_ActiveClients para modificar
	measure '05.30 Orders - Active Clients' =
			
			/// Usar em conjunto com a medida 02.15 ///
			VAR Seletor = [param_ActiveClients Valor]
			VAR dtFinal =
			    MAX ( dCalendario[Data] )
			VAR dtInicio =
			    EDATE ( dtFinal, - Seletor )
			RETURN
			    CALCULATE (
			        [05.00 Orders],
			        fVendas[order_status] IN { "Pronto", "Enviado", "Completo" },
			        DATESBETWEEN ( dCalendario[Data], dtInicio, dtFinal )
			    )
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 17e6cfd9-c6b8-4f54-93f6-4e6d8a61e763

	/// Ticket médio ponderado por cliente
	measure '04.21 ATP/Client' =
			
			AVERAGEX ( VALUES ( fVendas[client_account_id] ), [04.00 ATP] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 04. Average Ticket Price
		lineageTag: c2f0c5f4-c5e9-4671-9d61-5647ee995037

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Ticket médio dos clientes ativos no periodo selecionado.
	/// É necessário utilizar junto da medida [02.30]
	/// 
	/// O parametro que controla essa medida, por padrão, é [Data máxima] - 1 Mês
	/// 
	/// Usar a coluna param_ActiveClients para modificar
	measure '04.30 ATP - Active Clients' =
			
			VAR TKM =
			    DIVIDE ( [01.30 GMV - Active Clients], [05.30 Orders - Active Clients] )
			RETURN
			    AVERAGEX ( VALUES ( fVendas[client_account_id] ), TKM )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 04. Average Ticket Price
		lineageTag: b26b7e92-e5ad-4adc-804c-b4dbc35a8beb

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '05.01 % Orders AA' =
			
			DIVIDE ( [05.01 Orders AA], [05.00 Orders] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: 20. GT%
		lineageTag: 8b8ff3ad-36cc-4f22-9dec-452f9456f35e

		changedProperty = FormatString

	measure '05.02 % Orders VA' =
			
			DIVIDE ( [05.02 Orders VA], [05.00 Orders] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: 20. GT%
		lineageTag: b9aadd73-cdd4-416e-89b2-1bc9019a9569

		changedProperty = FormatString

	measure '05.03 % Orders MV' =
			
			DIVIDE ( [05.03 Orders MV], [05.00 Orders] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: 20. GT%
		lineageTag: bec6b5c3-b7b7-4e00-aa14-cc4db6f45d0e

		changedProperty = FormatString

	/// Valor de frete
	measure '05.23 Shipping price' =
			
			CALCULATE (
			    AVERAGEX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE (
			            SUM ( fVendas[median_charged_shipping] ),
			            NOT ( fVendas[order_status]
			                IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } )
			        )
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 05. Orders
		lineageTag: 4d99ce21-7903-4727-897c-1d09463c3718

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de pedidos transacionados pela plataforma, engloba todos os status
	/// 
	measure '05.55 Orders potential' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[partner_order_id] ),
			    ALL ( fVendas[order_status] )
			)
		formatString: 0
		displayFolder: 05. Orders
		lineageTag: 69569196-7dba-4051-b66a-00c1e5ff0857

	/// % de pedidos que são finalizados com sucesso
	measure '05.56 Orders to completion rate' =
			
			DIVIDE ( [05.00 Orders], [05.55 Orders potential] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05. Orders
		lineageTag: 4550236a-0dc9-4f4d-bb26-5d25f12e74cd

		changedProperty = FormatString

	/// Quantidade de logins
	measure '03.00 Logins' =
			
			CALCULATE ( COUNT ( fLogins[login_date] ), VALUES ( fLogins[account_id] ) )
		formatString: 0
		displayFolder: 03. Logins
		lineageTag: ed209fcc-0356-4eb1-88e4-9d548a29880e

	/// Quantidade de logins para 1 pedido
	measure '03.56 Login to order conversion rate' =
			
			DIVIDE ( [03.00 Logins], [05.55 Orders potential] )
		formatString: #,0.00
		displayFolder: 03. Logins
		lineageTag: 8ba7059d-a9e0-4d0e-8c1f-6de87d38f996

		changedProperty = FormatString

	/// Valor de desconto aplicado.
	measure '01.50 Discount value' =
			
			CALCULATE (
			    SUM ( fVendas[discount_value] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 426e2a6b-3ef1-48f8-8a2d-5a389dc96708

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Clientes com GMV.
	measure '02.55 Clients w GMV' =
			
			CALCULATE ( [02.00 Clients], FILTER ( dClientes, [01.00 GMV] ) )
		formatString: #,0
		displayFolder: 02. Clients
		lineageTag: 3d1b5105-badc-47e7-8d0c-8e2c510726e5

		changedProperty = FormatString

	measure '02.01 % Clients AA' =
			
