	/// Quantidade de login de vendedores
	measure '03.02 Seller login' =
			
			CALCULATE (
			    [03.00 Logins],
			    dVendedores[account_id] <> BLANK (),
			    USERELATIONSHIP ( dVendedores[account_id], fLogins[account_id] )
			)
		formatString: 0
