	measure wow% = ```
			
			VAR periodo_atual = 
			SELECTEDVALUE(dCalendario[Offset Semana])
			VAR periodo_anterior =
			SELECTEDVALUE(dCalendario[Offset Semana]) - 1
			VAR resultado_atual = 
			CALCULATE(
