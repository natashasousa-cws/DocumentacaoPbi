table Medidas
	lineageTag: 4a7822b7-4d35-4e13-9856-4681ba3aba83

	/// Soma dos totais de pedidos, excluindo pedidos com status:
	/// 
	/// - Cancelado
	/// - Aguardando pagamento
	/// - Pré-encomenda
	/// - Pagamento no caixa
	/// 
	/// As informações dos pedidos, encontram-se na tabela fVendas
	measure '01.00 GMV' =
			
			CALCULATE (
			    SUMX (
			        VALUES ( fVendas[partner_order_id] ),
			        CALCULATE (
			            AVERAGE ( fVendas[order_total] ),
			            NOT ( fVendas[order_status]
			                IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } )
			        )
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 970bac14-638d-4e33-bfdb-8f16c0d09fd9

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// GMV realizado 100% pelo cliente
	measure '01.01 GMV AA' =
			
			CALCULATE ( [01.00 GMV], fVendas[order_type] IN { "100% cliente" } )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: 3917b055-815f-4183-8b68-3c22ce29cfd9

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '01.01 % GMV AA' =
			
			DIVIDE ( [01.01 GMV AA], [01.00 GMV] )
		formatString: #,0%;-#,0%;#,0%
		displayFolder: 20. GT%
		lineageTag: 342d7342-66c1-45d9-b73e-db1e1328a5fb

		changedProperty = FormatString

	/// GMV realizado por interação cliente-vendedor
	measure '01.02 GMV VA' =
			
			CALCULATE ( [01.00 GMV], fVendas[order_type] IN { "Venda assistida" } )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: dcab3e3b-eecb-41c2-bee6-b326032031d7

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '01.02 % GMV VA' =
			
			DIVIDE ( [01.02 GMV VA], [01.00 GMV] )
		formatString: #,0%;-#,0%;#,0%
		displayFolder: 20. GT%
		lineageTag: 6f325507-75d2-43d0-a03b-591d684049fb

		changedProperty = FormatString

	/// GMV realizado 100% pelo vendedor
	measure '01.03 GMV MV' =
			
			CALCULATE ( [01.00 GMV], fVendas[order_type] IN { "100% vendedor" } )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
