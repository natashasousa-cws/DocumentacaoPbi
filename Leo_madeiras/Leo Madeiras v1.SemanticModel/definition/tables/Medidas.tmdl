	measure '03.02 % Logins seller' =
			
			VAR Seller_login_count =
			    CALCULATE (
			        DISTINCTCOUNT ( fLogins[account_id] ),
			        dVendedores[account_id] <> BLANK (),
			        USERELATIONSHIP ( dVendedores[account_id], fLogins[account_id] )
			    )
			RETURN
			    DIVIDE ( Seller_login_count, [07.00 Salesperson] )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: 20. GT%
