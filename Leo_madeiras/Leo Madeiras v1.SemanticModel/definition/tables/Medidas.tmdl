			    FILTER(
			        ALL(dCalendario),
			        dCalendario[Offset Semana] = periodo_atual
			    )
			)
			VAR resultado_anterior = 
			CALCULATE(
			    [01.00 GMV],
			    FILTER(
			        ALL(dCalendario),
			        dCalendario[Offset Semana] = periodo_anterior
			    )
			)
			RETURN
			DIVIDE(
			    resultado_atual-resultado_anterior,
			    resultado_anterior
			)
