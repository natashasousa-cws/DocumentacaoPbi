	/// Quantidade de logins de clientes
	measure '03.01 Client login' =
			
			CALCULATE ( [03.00 Logins], NOT ( ISBLANK ( dClientes[client_id] ) ) )
		formatString: 0
		displayFolder: 03. Logins
