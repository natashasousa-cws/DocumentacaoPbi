	measure '02.15 Clients in fVendas' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fVendas[client_account_id] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Pré-encomenda", "Cancelado" } )
			)
		formatString: #,0
