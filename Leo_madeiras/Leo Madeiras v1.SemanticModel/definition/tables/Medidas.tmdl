	/// Calculo do GMV por item, excluindo pedidos com status:
	/// 
	/// - Cancelado
	/// - Aguardando pagamento
	/// - Pré-encomenda
	/// - Pagamento no caixa
	/// 
	/// Utilizar para informar valores de GMV por categoria
	measure '01.40 GMV by line' =
			
			CALCULATE (
			    SUMX ( fVendas, fVendas[quantity] * fVendas[amount_charged] ),
			    NOT ( fVendas[order_status]
			        IN { "Aguardando pagamento", "Cancelado", "Pré-encomenda", "Pagamento no caixa" } )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01. GMV
		lineageTag: ecaaadf5-2537-4fda-ae82-ee956254f060

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '01.00 GMV LY' =
			
