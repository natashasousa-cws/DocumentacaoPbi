				    #"fb99b340-78bd-4098-bb83-8617444004c5" = #"2e47e558-68be-4ef5-958e-e70f7152788e"{[dataflowId="fb99b340-78bd-4098-bb83-8617444004c5"]}[Data],
				    dProdutos_ = #"fb99b340-78bd-4098-bb83-8617444004c5"{[entity="dProdutos",version=""]}[Data]
