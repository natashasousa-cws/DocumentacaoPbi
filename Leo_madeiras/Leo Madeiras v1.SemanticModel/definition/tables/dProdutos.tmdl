		summarizeBy: none
		sourceColumn: sku_name

		annotation SummarizationSetBy = Automatic

	column 'ABC Geral' =
			
			VAR gmv_sku = ADDCOLUMNS ( dProdutos, "vd_produto", [01.00 GMV] )
			VAR gmv_atual = [01.00 GMV]
			VAR class = FILTER ( gmv_sku, [vd_produto] >= gmv_atual )
			VAR gmv_acc = SUMX ( class, [vd_produto] )
			VAR total_venda = CALCULATE ( [01.00 GMV], ALL ( dProdutos ) )
			VAR pct_acc = DIVIDE ( gmv_acc, total_venda )
			VAR resultado =
			SWITCH (
			    TRUE,
			    pct_acc <= 0.80, "A",
			    pct_acc <= 0.95, "B",
			    "C"
			)
			RETURN
			    resultado
		lineageTag: fcd16546-03e0-4181-97be-e4e98c3adfe5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ABC AA Geral' =
			
			VAR gmv_sku = ADDCOLUMNS ( dProdutos, "vd_produto", [01.01 GMV AA] )
			VAR gmv_atual = [01.01 GMV AA]
			VAR class = FILTER ( gmv_sku, [vd_produto] >= gmv_atual )
			VAR gmv_acc = SUMX ( class, [vd_produto] )
			VAR total_venda = CALCULATE ( [01.01 GMV AA], ALL ( dProdutos ) )
			VAR pct_acc = DIVIDE ( gmv_acc, total_venda )
			VAR resultado =
			SWITCH (
			    TRUE,
			    pct_acc <= 0.80, "A",
			    pct_acc <= 0.95, "B",
			    "C"
			)
			RETURN
			    resultado
		lineageTag: 7fedfc78-2c36-4640-808d-f310f035eb9b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

