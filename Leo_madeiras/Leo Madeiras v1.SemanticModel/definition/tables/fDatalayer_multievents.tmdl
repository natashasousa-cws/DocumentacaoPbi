			    COUNT(fDatalayer_multievents[event])
			)
			```
		formatString: #,0
		lineageTag: 3c90ebe7-2821-4f9b-9c44-46bb3da4773b

	measure multievents_eventsXsession_avg =
			
			DIVIDE(
			    fDatalayer_multievents[multievents_event_count],
			    fDatalayer_multievents[multievents_session_distinctcount]
			)
		formatString: #,0.0
		lineageTag: eae09561-c6ce-4647-be51-cf679d39846a

	measure total_conversion_rate_multevents =
			
			VAR soma =
			    CALCULATE (
			        [05.01 Orders AA] + [05.02 Orders VA],
			        FILTER ( dClientes, [total_logged_session count] > 0 )
			    )
			VAR resultado =
			    COALESCE ( CALCULATE ( DIVIDE ( soma, [multievents_session_distinctcount] ) ), 0 )
			RETURN
			    IF ( resultado > 1, 1, resultado )
		lineageTag: ec884630-4472-4eb6-bbbb-6b1d630730cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

