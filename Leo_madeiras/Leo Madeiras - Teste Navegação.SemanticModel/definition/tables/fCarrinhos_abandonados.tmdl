table fCarrinhos_abandonados
	lineageTag: a9cbcf7a-ee4b-4eb8-9275-dffe18e40ed0

	measure '% abandonment_rate' =
			
			VAR pedidos_geral =
			    CALCULATE ( DISTINCTCOUNT ( fVendas[partner_order_id] ) )
			VAR carrinhos_geral =
			    CALCULATE (
			        DISTINCTCOUNT ( fCarrinhos_abandonados[session_id] ),
			        fCarrinhos_abandonados[cart_type] = "Carrinho abandonado"
			    )
			VAR carrinhos =
			    CALCULATE ( DISTINCTCOUNT ( fCarrinhos_abandonados[session_id] ) )
			VAR total = pedidos_geral + carrinhos_geral
			VAR taxa =
			    CALCULATE ( DIVIDE ( carrinhos, total, 0 ) )
			RETURN
			    taxa
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 59f7ccd6-b885-4ccf-913d-a28ba7199e5c

	measure abandoned_carts =
			
			CALCULATE ( DISTINCTCOUNT ( fCarrinhos_abandonados[session_id] ) )
		formatString: #,0
		lineageTag: 441ab3b7-2670-4a71-bb61-dd6e753f4fc7

	measure abandoned_carts_gmv =
			
			CALCULATE ( SUM ( fCarrinhos_abandonados[unit_price] ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 31f06a92-8e57-441f-b7cc-6e44f7ba7a11

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% by item' =
			
			VAR carrinhos_total =
			    CALCULATE (
			        fCarrinhos_abandonados[abandoned_carts],
			        ALL ( fCarrinhos_abandonados[sku_name] )
			    )
			VAR divs =
			    CALCULATE (
			        DIVIDE ( fCarrinhos_abandonados[abandoned_carts], carrinhos_total, 0 )
			    )
			RETURN
			    divs
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6a1d6a19-642b-453d-be75-f6f1c86d7e56

