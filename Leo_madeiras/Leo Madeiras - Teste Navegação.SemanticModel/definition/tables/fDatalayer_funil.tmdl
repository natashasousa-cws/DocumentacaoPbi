			)
		formatString: #,0
		lineageTag: c6bf1b3e-9b5d-42cd-b0a4-938700299dfa

	measure funnel_logged_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    fDatalayer_funil[client_id] <> 0
			)
		formatString: #,0
		lineageTag: 18fef531-9309-4b2b-a82f-db4c3cb6ea12

	measure funnel_distinct_clients =
			
			CALCULATE ( DISTINCTCOUNT ( fDatalayer_funil[client_id] ) )
		formatString: #,0
		lineageTag: 1b8c2af0-c330-48bb-b7f2-f92b4d491a9f

	measure funnel_pagepath_count =
			
			CALCULATE ( DISTINCTCOUNT ( fDatalayer_funil[pagepath] ) )
		formatString: #,0
		lineageTag: f9efab05-346d-4407-8279-962d5251aef7

	measure funnel_freight_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    fDatalayer_funil[pagepath] = "/escolha-frete"
			)
		formatString: #,0
		lineageTag: 4ebd6765-a239-4852-97c6-61138c31e62e

	measure funnel_purchase_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    fDatalayer_funil[event] = "purchase"
			)
		formatString: 0
		lineageTag: 1dc42cb8-cac4-491f-bb44-7c656ac8abc2

	measure funnel_%purchase_sessions =
			
			CALCULATE (
			    DIVIDE (
			        [funnel_purchase_session_count],
			        fDatalayer_funil[funnel_session_count],
			        0
			    )
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: d7e9de23-b814-4ee1-9ad7-cc171fa000e2

	measure funnel_%logged_sessions =
			
			CALCULATE (
			    DIVIDE (
			        [funnel_logged_session_count],
			        fDatalayer_funil[funnel_session_count],
			        0
			    )
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 4d48b0f0-ded1-4dde-9a69-0457751c2b74

	measure funnel_%order_sessions =
			
			CALCULATE (
			    DIVIDE ( [05.00 Orders], fDatalayer_funil[funnel_session_count], 0 )
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: fe5ed9fe-3fab-4c95-aa38-f556a8fa390e

	measure funnel_pageviewXsession_avg =
			
			VAR Pageview =
			    CALCULATE (
			        COUNT ( fDatalayer_funil[pagepath] ),
			        fDatalayer_funil[event] = "pageView"
			    )
			RETURN
			    CALCULATE ( DIVIDE ( Pageview, [funnel_session_count], 0 ) )
		formatString: #,0.00
		lineageTag: 9a357631-56a2-436f-8b59-d2ad1a200811

	measure 'Taxa de abandono - explicação' =
			
			"(Carrinhos + pré-encomenda)" & UNICHAR ( 13 )
			    & UNICHAR ( 10 ) & "/ (Pedidos todos status + carrinhos)"
		lineageTag: 1b85bc61-0dab-42e0-af69-a4baae54f851

	measure 'funnel_pageview_session_count true' =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    ( fDatalayer_funil[event]
			        IN { "pageView", "add-to-cart" }
			            && fDatalayer_funil[sku_id] <> 0 )
			)
		formatString: 0
		lineageTag: 21d90562-1605-498c-9282-9c4cfcc13aa0

