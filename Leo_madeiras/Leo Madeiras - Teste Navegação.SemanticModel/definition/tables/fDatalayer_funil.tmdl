table fDatalayer_funil
	lineageTag: 50b0213b-dddf-4770-a1e9-85916fedcbe0

	measure avg_session_time =
			
			VAR tempo =
			    CALCULATE (
			        AVERAGEX (
			            VALUES ( fDatalayer_funil[session] ),
			            AVERAGE ( fDatalayer_funil[session_time_total] )
			        )
			    )
			VAR hora =
			    INT ( tempo / 3600 )
			VAR modhora =
			    MOD ( tempo, 3600 )
			VAR minutos =
			    INT ( modhora / 60 )
			VAR segundos =
			    INT ( MOD ( tempo, 60 ) )
			RETURN
			    hora * 10000 + minutos * 100 + segundos
		formatString: 00:00:00
		lineageTag: 3f8205b4-7e29-4a12-9d0e-b72c67246cf1

		annotation PBI_FormatHint = {"isCustom":true}

	measure funnel_session_count =
			
			CALCULATE ( DISTINCTCOUNT ( fDatalayer_funil[session] ) )
		formatString: #,0
		lineageTag: 84ffc83d-ec9f-4794-b6db-83f085e57553

	measure funnel_pageview_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    fDatalayer_funil[event] = "pageView"
			)
		formatString: #,0
		lineageTag: a17652ab-28a1-49e6-b480-629dbd10ed0e

	measure funnel_addtocart_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
			    fDatalayer_funil[event] = "add_to_cart"
			)
		formatString: #,0
		lineageTag: 54214b7a-3206-41c9-8727-031103e2fe75

	measure funnel_viewcart_session_count =
			
			CALCULATE (
			    fDatalayer_funil[funnel_session_count],
