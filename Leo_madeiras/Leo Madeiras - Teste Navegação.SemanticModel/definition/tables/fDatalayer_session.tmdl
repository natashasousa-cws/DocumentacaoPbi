table fDatalayer_session
	lineageTag: e27b651e-eb50-4fac-8572-a626c9d3c926

	measure 'total_logged_session count' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fDatalayer_session[session] ),
			    NOT ( ISBLANK ( fDatalayer_session[client_id] ) ),
			    fDatalayer_session[session_user_type] = "Cliente navegando"
			)
		formatString: #,0
		lineageTag: 297e7eb4-2103-4bfa-8121-2e1c6026c404

	measure total_itens_view =
			
			CALCULATE (
			    DISTINCTCOUNT ( fDatalayer_session[sku_id] ),
			    fDatalayer_session[client_id] <> 0,
			    fDatalayer_session[session_user_type] = "Cliente navegando"
			)
		formatString: #,0
		lineageTag: d90ea22e-b52a-4d9c-b6a2-db5a3dc1a622

	measure total_conversion_rate =
			
			VAR soma =
			    CALCULATE (
			        [05.01 Orders AA] + [05.02 Orders VA],
			        FILTER ( dClientes, [total_logged_session count] > 0 )
			    )
			VAR resultado =
			    COALESCE ( CALCULATE ( DIVIDE ( soma, [total_logged_session count] ) ), 0 )
			RETURN
			    IF ( resultado > 1, 1, resultado )
		formatString: #,0%;-#,0%;#,0%
		lineageTag: 8872adee-95f0-4248-a17f-ee7813652dd3

	measure last_view =
			
			CALCULATE ( MAX ( fDatalayer_session[datetime] ) )
		formatString: General Date
		lineageTag: 60182b69-850c-45d5-9238-4d5587d9abd0

	measure client_session_count =
			
			CALCULATE (
			    DISTINCTCOUNT ( fDatalayer_session[session] ),
			    fDatalayer_session[session_user_type] = "Cliente navegando"
			)
		formatString: #,0
		lineageTag: 92412336-b509-4859-8244-e58fb6e6b30b

	measure salesperson_session_count =
			
			CALCULATE (
			    DISTINCTCOUNT ( fDatalayer_session[session] ),
			    fDatalayer_session[session_user_type]
			        IN { "Vendedor navegando", "Vendedor atuando" }
			)
		formatString: #,0
		lineageTag: f9c6ebc9-6e42-442a-85f2-2a571e26bb97

	measure session_count =
			
			COALESCE ( CALCULATE ( DISTINCTCOUNT ( fDatalayer_session[session] ) ), 0 )
		formatString: #,0
		lineageTag: f4fd52d2-e086-49b9-b512-4b9f40b3fd91

	measure total_viewed_sku =
			
			CALCULATE ( DISTINCTCOUNT ( fDatalayer_session[sku_id] ) )
		formatString: #,0
		lineageTag: 9d142a21-7730-4836-905c-aeafd6bab58a

	measure %_catalogue_viewed =
			
			CALCULATE ( DIVIDE ( [total_viewed_sku], [catalogue_count], 0 ) )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: db05ea9d-f727-4e34-8a65-e48b44713dae

	measure viewed_and_bought_itens =
			
			CALCULATE (
			    DISTINCTCOUNT ( dProdutos[sku_id] ),
			    FILTER ( dProdutos, [total_conversion_rate] > 0 )
			)
		formatString: #,0
		lineageTag: 7eda7948-67a0-4bd2-b6af-1e00c6f45ba4

	measure client_conversion_rate =
			
			VAR soma =
			    CALCULATE (
			        [05.01 Orders AA] + [05.02 Orders VA],
			        CROSSFILTER ( fDatalayer_session[sku_id], dProdutos[sku_id], BOTH ),
			        FILTER ( dProdutos, [total_logged_session count] > 0 )
			    )
			VAR resultado =
			    COALESCE ( CALCULATE ( DIVIDE ( soma, [total_logged_session count] ) ), 0 )
			RETURN
			    IF ( resultado > 1, 1, resultado )
		formatString: #,0%;-#,0%;#,0%
		lineageTag: 1b5fe016-3b5f-4e0a-ad85-effbf5cbf764

	measure pageview/session =
			
			CALCULATE ( DIVIDE ( [total_viewed_sku], [session_count], 0 ) )
		lineageTag: 92083a26-13b4-4921-8e2f-16901ab544bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% logged session' =
			
			CALCULATE ( DIVIDE ( [total_logged_session count], [session_count], 0 ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 985417d6-7ccb-4331-b9f2-334a47d7c1e5

	measure client_count_pageview =
			
			CALCULATE ( DISTINCTCOUNT ( fDatalayer_session[client_id] ) )
		formatString: 0
		lineageTag: c76ba5bf-12b5-4040-8dee-726456c644b9

