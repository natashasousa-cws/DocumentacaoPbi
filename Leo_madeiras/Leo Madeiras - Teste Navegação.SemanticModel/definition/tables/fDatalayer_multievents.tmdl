table fDatalayer_multievents
	lineageTag: 5702ad7f-4871-4044-ae98-10806fa8d1b0

	measure avg_session_time_multievents =
			
			VAR tempo =
			    CALCULATE (
			        AVERAGEX (
			            VALUES ( fDatalayer_multievents[session]),
			            AVERAGE ( fDatalayer_multievents[session_time_total] )
			        )
			    )
			VAR hora =
			    INT ( tempo / 3600 )
			VAR modhora =
			    MOD ( tempo, 3600 )
			VAR minutos =
			    INT ( modhora / 60 )
			VAR segundos =
			    INT ( MOD ( tempo, 60 ) )
			RETURN
			    hora * 10000 + minutos * 100 + segundos
		formatString: 00:00:00
		lineageTag: a1a30b7a-30a5-4d4f-bca7-be8ad2828fa6

		annotation PBI_FormatHint = {"isCustom":true}

	measure multievents_session_distinctcount = ```
			
			CALCULATE( 
			    DISTINCTCOUNT(fDatalayer_multievents[session])
			)
			```
		formatString: #,0
		lineageTag: 1b17ae77-758d-48ce-85a0-c3f658c69297

	measure multievents_pagepath_distinctcount = ```
			
			CALCULATE( 
			    DISTINCTCOUNT(fDatalayer_multievents[pagepath])
			)
			```
		formatString: #,0
		lineageTag: 75a51d59-e82e-4c0c-9ef4-4793ecc3e607

	measure multievents_pagepath_count = ```
			
			CALCULATE( 
			    COUNT(fDatalayer_multievents[pagepath])
			)
			```
		formatString: #,0
		lineageTag: 1ac55b4f-877e-430a-b04e-9349f458b76a

	measure multievents_event_count = ```
			
			CALCULATE( 
			    COUNT(fDatalayer_multievents[event])
			)
			```
		formatString: #,0
		lineageTag: 3c90ebe7-2821-4f9b-9c44-46bb3da4773b

	measure multievents_eventsXsession_avg =
			
			DIVIDE(
			    fDatalayer_multievents[multievents_event_count],
			    fDatalayer_multievents[multievents_session_distinctcount]
			)
		formatString: #,0.0
		lineageTag: eae09561-c6ce-4647-be51-cf679d39846a

