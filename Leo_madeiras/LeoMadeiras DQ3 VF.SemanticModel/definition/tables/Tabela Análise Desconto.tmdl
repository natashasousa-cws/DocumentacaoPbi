	partition 'Tabela Análise Desconto' = calculated
		mode: import
		source =
				
				SUMMARIZE(
				    fFaturas,
				    fFaturas[cod_pedido],
				    fFaturas[cd_canal_venda],fFaturas[cd_cabecalho_entrega],fFaturas[cd_loja_venda],fFaturas[dt_fatura],fFaturas[ped_nr_pedido],fFaturas[cd_tipo_doc_fat],fFaturas[cd_cond_pgto],
