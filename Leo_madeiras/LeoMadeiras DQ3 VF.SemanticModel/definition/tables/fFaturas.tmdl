table fFaturas
	lineageTag: 23e1e886-3b77-4582-8ab8-4560d84bed5f

	measure 'TKM Liquido' =
			
			VAR valor = SUM(fFaturas[vlr_receita_liquida])
			VAR ped = DISTINCTCOUNT(fFaturas[nr_nf])
			RETURN
			DIVIDE(
			        valor,
			        ped,
			        0
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: b3f2ddb9-aa01-4f2f-ade2-cf494aa45bea

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

