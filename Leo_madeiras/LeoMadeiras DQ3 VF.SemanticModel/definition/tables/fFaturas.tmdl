	partition fFaturas = m
		mode: import
		queryGroup: Fact
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"703982af-9ccf-425c-9d6d-d22191c6e238" = Workspaces{[workspaceId="703982af-9ccf-425c-9d6d-d22191c6e238"]}[Data],
				    #"5acfb7f3-133f-4b84-9e8f-15a4b16ff5b5" = #"703982af-9ccf-425c-9d6d-d22191c6e238"{[dataflowId="5acfb7f3-133f-4b84-9e8f-15a4b16ff5b5"]}[Data],
				    Consulta_ = #"5acfb7f3-133f-4b84-9e8f-15a4b16ff5b5"{[entity="fFaturas_offline",version=""]}[Data],
				    #"Merged Queries" = Table.NestedJoin(Consulta_, {"cod_pedido"}, aux_pedidos, {"ped_nr_pedido"}, "aux_pedidos", JoinKind.LeftOuter),
				    #"Expanded aux_pedidos" = Table.ExpandTableColumn(#"Merged Queries", "aux_pedidos", {"ped_nr_pedido"}, {"ped_nr_pedido"})
				in
				    #"Expanded aux_pedidos"

	annotation PBI_ResultType = Table

