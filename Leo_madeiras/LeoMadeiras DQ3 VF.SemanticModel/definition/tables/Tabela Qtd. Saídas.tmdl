	partition 'Tabela Qtd. Saídas' = calculated
		mode: import
		source =
				
				SUMMARIZE(
				    'fFaturas',
				    'fFaturas'[cod_pedido],
				    'fFaturas'[dt_fatura],
				    fFaturas[cd_loja_venda],
				    dCanal_vendas[cd_canal_venda],
				    "Venda_bruta", [Venda bruta],
				    "QuantidadeTiposFrete", COUNTROWS( DISTINCT( 'fFaturas'[cd_cabecalho_entrega] ) ),
				    "QuantidadeCondicaoPagamento", COUNTROWS( DISTINCT( 'fFaturas'[cd_cond_pgto] ) ),
				    "QuantidadeFormaPagamento", COUNTROWS( DISTINCT( 'fFaturas'[cd_frm_pgto] ) ),
				    "QuantidadeProdutos", COUNTROWS( DISTINCT( 'fFaturas'[cod_material] ) )
				)

	annotation PBI_Id = 796f3444c2204fb5976321d692a4e274

