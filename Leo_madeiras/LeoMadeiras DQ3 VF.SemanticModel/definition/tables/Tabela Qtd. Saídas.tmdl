			    TRUE(),
			    'Tabela Qtd. Saídas'[QuantidadeTiposFrete] = 1, "1 Tipo",
			    'Tabela Qtd. Saídas'[QuantidadeTiposFrete] = 2, "2 Tipos",
			    'Tabela Qtd. Saídas'[QuantidadeTiposFrete] = 3, "3 Tipos",
			    'Tabela Qtd. Saídas'[QuantidadeTiposFrete] = 4, "4 Tipos",
			    'Tabela Qtd. Saídas'[QuantidadeTiposFrete] >= 5, "5 ou Mais Tipos"
