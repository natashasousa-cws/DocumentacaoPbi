	column UF =
			
			SWITCH(
			    TRUE(),
			    LEFT(dClientes[cep], 2) >= "00" && LEFT(dClientes[cep], 2) <= "19", "SP",
			    LEFT(dClientes[cep], 2) >= "20" && LEFT(dClientes[cep], 2) <= "28", "RJ",
			    LEFT(dClientes[cep], 2) = "29", "ES",
			    LEFT(dClientes[cep], 2) >= "30" && LEFT(dClientes[cep], 2) <= "39", "MG",
			    LEFT(dClientes[cep], 2) >= "40" && LEFT(dClientes[cep], 2) <= "48", "BA",
			    LEFT(dClientes[cep], 2) = "49", "SE",
			    LEFT(dClientes[cep], 2) >= "50" && LEFT(dClientes[cep], 2) <= "56", "PE",
			    LEFT(dClientes[cep], 2) >= "57" && LEFT(dClientes[cep], 2) <= "59", "AL",
			    LEFT(dClientes[cep], 2) = "59", "RN",
			    LEFT(dClientes[cep], 2) >= "60" && LEFT(dClientes[cep], 2) <= "64", "CE",
			    LEFT(dClientes[cep], 2) = "64", "PI",
			    LEFT(dClientes[cep], 2) = "65", "MA",
			    LEFT(dClientes[cep], 2) >= "66" && LEFT(dClientes[cep], 2) <= "67", "PA",
			    LEFT(dClientes[cep], 2) = "68", "AM",
			    LEFT(dClientes[cep], 2) = "69", "AC",
			    LEFT(dClientes[cep], 2) = "69", "RO",
			    LEFT(dClientes[cep], 2) >= "70" && LEFT(dClientes[cep], 2) <= "72", "DF",
			    LEFT(dClientes[cep], 2) >= "73" && LEFT(dClientes[cep], 2) <= "75", "GO",
			    LEFT(dClientes[cep], 2) >= "76" && LEFT(dClientes[cep], 2) <= "77", "TO",
			    LEFT(dClientes[cep], 2) = "77", "TO",
			    LEFT(dClientes[cep], 2) = "78", "MT",
			    LEFT(dClientes[cep], 2) = "79", "MS",
			    LEFT(dClientes[cep], 2) >= "80" && LEFT(dClientes[cep], 2) <= "87", "PR",
			    LEFT(dClientes[cep], 2) >= "88" && LEFT(dClientes[cep], 2) <= "89", "SC",
			    LEFT(dClientes[cep], 2) >= "90" && LEFT(dClientes[cep], 2) <= "99", "RS",
			    "Unknown"
			)
		lineageTag: e619ef69-482a-4f9e-8e62-64134b8ea5b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

